{
  "realm": "dds-tareas",
  "displayName": "DDS-TAREAS",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "roles": {
    "realm": [
      {
        "name": "usuario",
        "description": "Usuario común del álbum"
      },
      {
        "name": "admin",
        "description": "Administrador del sistema"
      }
    ]
  },
  "defaultRoles": [
    "usuario"
  ],
  "clients": [
    {
      "clientId": "dds-tareas-node-backend",
      "name": "DDS Tareas Node Backend",
      "description": "Cliente público usado por backend_usuario para Authorization Code Flow con PKCE",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:4000/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "plain",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:4000/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Usuario",
      "email": "demo@album.local",
      "credentials": [
        {
          "type": "password",
          "value": "Clave123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "usuario"
      ]
    }
  ]
}
